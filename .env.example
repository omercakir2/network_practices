POSTGRES_USER=network
POSTGRES_PASSWORD=network
POSTGRES_DB=network
POSTGRES_PORT=5432

# Host-networked scanner talks to Postgres via the published host port.
DATABASE_URL=postgres://network:network@127.0.0.1:5432/network?sslmode=disable

# Optional SSH inventory (-ssh). Comma-separated alternatives; cartesian product.
# Never commit real passwords. The scanner never prints these values.
SSH_USERS=admin,root
SSH_PASSWORDS=password123,psw123!
SSH_PORT=22
